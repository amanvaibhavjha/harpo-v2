# HARPO pipeline configuration: paths, models, GPU.
#
# Source it once per shell session before running stages manually:
#   source harpo.env
#
# The names match what reproduce.sh itself reads from the environment, so
# this also works as its config file:
#   source harpo.env && bash reproduce.sh
#
# Override anything by exporting it yourself before sourcing, e.g.:
#   OUT=/data/harpo_out GPU0=0 GPU1=1 bash -c 'source harpo.env && bash reproduce.sh'

# Where checkpoints, results and logs are written.
export OUT=./harpo_out

# Converted ReDial data (sft_data.json, test_sft.json, movie_list.json) and
# the original ReDial release (train_data.jsonl, test_data.jsonl).
export DATA=$OUT/data/redial_data
export RAW=$OUT/redial_raw

# Models.
export M05=Qwen/Qwen2.5-0.5B-Instruct
export M7=Qwen/Qwen2.5-7B-Instruct

# GPUs: reproduce.sh runs two lanes in parallel when these differ. For the
# single-GPU manual steps in MANUAL_STEPS.md, only GPU0 is used.
export GPU0=0
export GPU1=0

# Derived paths (reproduce.sh computes these itself; MANUAL_STEPS.md needs
# them spelled out since it calls each stage directly).
export CK=$OUT/checkpoints
export RES=$OUT/results
export AG=$RES/agents
export PROF=$RES/bridge/profiles.json
export CK7=$CK/7b/checkpoints/sft_final
export READ=$RES/readings_0.json,$RES/readings_1.json

export PYTHONUNBUFFERED=1
export CUDA_VISIBLE_DEVICES=$GPU0

# Shared flags used across most stages (arrays: not exported to child
# processes, but bash expands "${S5[@]}" before invoking python, so this
# works fine as long as you source this file in the same shell you run the
# python commands from).
S5=(--val-fraction 0.05 --charm-fraction 0.0)
BACKBONE=(--train-size 0 --test-size 0 --catalog-size 100000 --seq-len 256
          --batch-size 16 --grad-accum 1 --catalog-refresh 250)
